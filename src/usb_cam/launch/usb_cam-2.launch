<launch>
  <node name="usb_cam_2" pkg="usb_cam" type="usb_cam_node" output="screen" >
    <param name="video_device" value="/dev/v4l/by-path/platform-70090000.xusb-usb-0:2.3:1.0-video-index0" />
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="pixel_format" value="yuyv" />
    <param name="camera_frame_id" value="usb_cam" />
    <param name="image_topic" value="image" />
    <param name="io_method" value="mmap"/>
  </node>
  <node name="image_view_2" pkg="image_view" type="image_view" respawn="false" output="screen">
    <remap from="image" to="/usb_cam_2/image"/>
    <param name="autosize" value="true" />
  </node>
</launch>
